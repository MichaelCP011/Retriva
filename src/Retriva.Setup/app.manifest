<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <!--
    Meminta hak administrator sebelum proses berjalan.

    requireAdministrator, bukan asInvoker. Wizard ini memeriksa apakah hak
    administrator ada, dan menjalankannya tanpa hak itu berarti pemeriksaannya
    selalu gagal — lalu orangnya harus menutup jendela dan mengulang dengan klik
    kanan. Dialog UAC yang dimunculkan Windows sekali di awal jauh lebih baik
    daripada pemeriksaan yang memberi tahu bahwa cara menjalankannya salah.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!--
    Tanpa blok ini, Environment.OSVersion melaporkan Windows 8 pada Windows 10
    dan 11 — kompatibilitas warisan yang masih aktif sampai sekarang. Pemeriksaan
    versi Windows di Prerequisites.cs akan selalu salah, dan salahnya ke arah
    yang paling buruk: Windows 11 dilaporkan terlalu lama.
  -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
